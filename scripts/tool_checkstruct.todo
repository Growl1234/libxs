# Open findings, one line per rule and file: <rule> <count> <path>.
#
# This is a to-do list, not a permission: the count is a ratchet, so one
# finding more than listed fails the hook, and one less fails too, asking for
# the number to come down. Delete the line once the file is clean.
#
# Per project, and deliberately not a policy file: "make documentation" copies
# tool_checkstruct.py from LIBXS and would revert a count lowered here.
# Regenerate with: scripts/tool_checkstruct.py --counts $(git ls-files)
# samples/converse is a live sample with its own to-do list; the three rules the
# "structure-anywhere" hook applies tree-wide are deferred there rather than
# scrubbed under someone else's work in progress.
closer-nesting      1  samples/converse/converse_recomb.c
stacked-comments    9  samples/converse/converse.c
stacked-comments    1  samples/converse/converse.h
stacked-comments    2  samples/converse/converse_hier.c
stacked-comments    5  samples/converse/converse_lm.c
stacked-comments   12  samples/converse/converse_qa.c
stacked-comments    6  samples/converse/converse_recomb.c
# section-order is new. Every finding below predates it: the rule is a ratchet
# from here on. 11 of the 28 are in headers, and nearly all of those are the
# same shape -- a macro or a type placed with the feature it belongs to rather
# than with its kind, which is the section order read across a file instead of
# along it. libxs_predict.c and libxs_math.c hold the exception the policy
# already names: a translation unit includes its implementation fragments where
# their code belongs.
section-order       2  libxs/libxs_macros.h
section-order       1  libxs/libxs_predict.h
section-order       3  libxs/libxs_sync.h
section-order       2  libxs/libxs_utils.h
section-order       1  src/libxs_cpuid_x86.c
section-order       1  src/libxs_hash.c
section-order       1  src/libxs_main.c
section-order       3  src/libxs_math.c
section-order       1  src/libxs_math_fprint.h
section-order       1  src/libxs_perm.c
section-order       1  src/libxs_perm_kdtree.h
section-order       4  src/libxs_predict.c
section-order       1  src/libxs_reg.c
section-order       1  src/libxs_rng.c
